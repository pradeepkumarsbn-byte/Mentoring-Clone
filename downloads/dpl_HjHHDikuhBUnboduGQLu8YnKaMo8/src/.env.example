AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
AUTH_SECRET="generate-a-private-auth-secret"
MENTORING_SHEETS_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
MENTORING_SHEETS_TOKEN="your-private-connection-token"

# Switch only after import, permissions and password login have been verified.
MENTORING_BACKEND="sheets"
MENTORING_SITE_URL="https://mentoring-clone-map.vercel.app"
MENTORING_SUPABASE_URL="https://your-dedicated-project.supabase.co"
MENTORING_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Server-only backup credential. Never use NEXT_PUBLIC_ for this key.
MENTORING_SUPABASE_SECRET_KEY="your-secret-key"
# Local migration credential only; do not deploy the database password.
MENTORING_DATABASE_URL="postgresql://postgres.project:URL_ENCODED_PASSWORD@pooler-host:5432/postgres"
# Set this as CRON_SECRET in the Mentoring Vercel project.
MENTORING_BACKUP_CRON_SECRET="generate-a-random-secret"
